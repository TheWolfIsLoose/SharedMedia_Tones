# SharedMedia: Tones - BigWigsMods packager config.
# Used by .github/workflows/release.yml and by CurseForge's own packager.
# Release process: Dev/RELEASING.md.

package-as: SharedMedia_Tones

# Libraries are committed so a plain checkout is directly installable; the
# packager swaps in upstream HEAD at release time.
externals:
  libs/LibStub: https://repos.curseforge.com/wow/libstub/trunk
  libs/CallbackHandler-1.0: https://repos.curseforge.com/wow/callbackhandler/trunk/CallbackHandler-1.0
  libs/LibSharedMedia-3.0: https://repos.curseforge.com/wow/libsharedmedia-3-0/trunk/LibSharedMedia-3.0

# Meaningless without its libraries, so never build a nolib zip.
enable-nolib-creation: no

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

# Stripped from the packaged zip. Keep comments on their own lines: an
# inline `# ...` after an entry silently breaks that entry.
ignore:
  - README.md
  - Dev
  - .github
  - .gitignore
  - .gitattributes
  - .pkgmeta
  # LibStub's external ships unit tests and a stub .toc WoW would load as
  # a separate addon.
  - libs/LibStub/tests
  - libs/LibStub/LibStub.toc
